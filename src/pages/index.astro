---
import Header from "../components/Header";
import Navbar from "../components/Navbar.jsx";
import PreHeader from "../components/PreHeader.jsx";
---

<link
  href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css"
  rel="stylesheet"
/>
<script
  src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"
  defer></script>
<link rel="stylesheet" href="/css/style.css" />
<PreHeader client:load />
<Header client:load />
<Navbar client:load />

<!-- Who we Are start-->
<section class="container-fluid section-space section-bg-1" id="about">
  <div class="container">
    <h2 class="center">Who we Are</h2>

    <div class="row">
      <div class="col-md-6 col-sm-12">
        <div class="left res-image-bottom res-image-bottom-1">
          <img src="images/750x500x1.jpg" alt="image" class="img-responsive" />
        </div>
      </div>
      <div class="col-md-6 col-sm-12">
        <div class="left care-top">
          <p class="p-bottom">
            At Integrity Commercial Openings we strive to build lasting and mutually beneficial relationships by providing high quality commercial products with outstanding customer service to our partners. 
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Who we Are end -->

<!-- Our Services start -->
<section class="container-fluid section-space section-bg-2" id="services">
  <div class="container">
    <h2 class="center">Our Services</h2>
    <div class="center no-fs underline-bottom"></div>

    <div class="row">
      <div class="col-md-4 col-sm-6 col-xs-6 event-width">
        <div class="left common-row-space">
          <ul class="content-ul no-padding no-margin">
            <li class="distab-cell-top">
              <img src="images/80x80x1.png" alt="icon" />
            </li>
            <li class="services-padding distab-cell-middle">
              <h3 class="left h3-bottom">Redesign Assistance</h3>
              <p class="ls">Sentence or two about Redsign Assistance</p>
              <p class="left link-top link ls"></p>
            </li>
          </ul>
        </div>
      </div>
      <div class="col-md-4 col-sm-6 col-xs-6 event-width">
        <div class="left common-row-space">
          <ul class="content-ul no-padding no-margin">
            <li class="distab-cell-top">
              <img src="images/80x80x2.png" alt="icon" />
            </li>
            <li class="services-padding distab-cell-middle">
              <h3 class="left h3-bottom">Project Management</h3>
              <p class="ls">Snippet about Project Management</p>
              <p class="left link-top link ls"></p>
            </li>
          </ul>
        </div>
      </div>
      <div class="col-md-4 col-sm-6 col-xs-6 event-width">
        <div class="left common-row-space">
          <ul class="content-ul no-padding no-margin">
            <li class="distab-cell-top">
              <img src="images/80x80x3.png" alt="icon" />
            </li>
            <li class="services-padding distab-cell-middle">
              <h3 class="left h3-bottom">Installation</h3>
              <p class="ls">Sentence or two about installation</p>
              <p class="left link-top link ls"></p>
            </li>
          </ul>
        </div>
      </div>
      <div class="col-md-4 col-sm-6 col-xs-6 event-width">
        <div class="left common-res-bottom common-res-bottom-1">
          <ul class="content-ul no-padding no-margin">
            <li class="distab-cell-top">
              <img src="images/80x80x4.png" alt="icon" />
            </li>
            <li class="services-padding distab-cell-middle">
              <h3 class="left h3-bottom">Maintenance</h3>
              <p class="ls">Sentence about maintenance</p>
              <p class="left link-top link ls"></p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Our Services end -->