---
import Header from "../components/Header";
import Navbar from "../components/Navbar.jsx";
import PreHeader from "../components/PreHeader.jsx";
---
<link
  href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css"
  rel="stylesheet"
/>
<script
  src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"
  defer></script>
<link rel="stylesheet" href="/css/style.css" />
<PreHeader client:load />
<Header client:load />
<Navbar client:load />

<!-- Who we Are start-->
<section class="container-fluid section-space section-bg-1" id="about">
  <div class="container">
    <h2 class="center">Who we Are</h2>

    <div class="row">
      <div class="col-md-6 col-sm-12">
        <div class="left res-image-bottom res-image-bottom-1">
          <img src="images/wooddoors.png" alt="image" class="img-responsive" />
        </div>
      </div>
      <div class="col-md-6 col-sm-12">
        <div class="left care-top">
          <p class="p-bottom">
           We are a commercial door, frame, and hardware company dedicated to building lasting, mutually beneficial relationships. Our mission is to provide high-quality commercial products with exceptional customer service and integrity in every project.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Who we Are end -->

<!-- Our Services start -->
<section class="container-fluid section-space section-bg-2" id="services">
  <div class="container">
    <h2 class="center">Our Services</h2>
    <div class="center no-fs underline-bottom"></div>
    <div class="row">
      <div class="col-md-4 col-sm-6 col-xs-6 event-width">
        <div class="left common-row-space">
          <ul class="content-ul no-padding no-margin">

            <li class="services-padding distab-cell-middle">
              <h3 class="left h3-bottom">Design and Development</h3>
              <p class="ls">We take our customers&#39; needs and develop solutions that meet those requirements while maintaining compliance with building codes and standards for architectural openings.</p>
            </li>
          </ul>
        </div>
      </div>
      <div class="col-md-4 col-sm-6 col-xs-6 event-width">
        <div class="left common-row-space">
          <ul class="content-ul no-padding no-margin">
            <li class="services-padding distab-cell-middle">
              <h3 class="left h3-bottom">Specification Writing</h3>
              <p class="ls">We create detailed door and hardware specifications and schedules tailored to each project&#39;s needs and the requirements of the Authority Having Jurisdiction (AHJ).</p>
            </li>
          </ul>
        </div>
      </div>
      <div class="col-md-4 col-sm-6 col-xs-6 event-width">
        <div class="left common-row-space">
          <ul class="content-ul no-padding no-margin">
            <li class="services-padding distab-cell-middle">
              <h3 class="left h3-bottom">Budgeting</h3>
              <p class="ls">We provide accurate budget estimates for all stages of the building and design process to help clients plan effectively and make informed decisions.</p>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div>      
      <div class="col-md-4 col-sm-6 col-xs-6 event-width">
        <div class="left common-res-bottom common-res-bottom-1">
          <ul class="content-ul no-padding no-margin">

            <li class="services-padding distab-cell-middle">
              <h3 class="left h3-bottom">Project Delivery</h3>
              <p class="ls">We handle estimating, detailing, and procurement for commercial doors, frames, and hardware—ensuring each project runs smoothly from start to finish.</p>
            </li>
          </ul>
        </div>
      </div>
            <div class="col-md-4 col-sm-6 col-xs-6 event-width">
        <div class="left common-res-bottom common-res-bottom-1">
          <ul class="content-ul no-padding no-margin">
            <li class="services-padding distab-cell-middle">
              <h3 class="left h3-bottom"></h3>
              <p class="ls"></p>
            </li>
          </ul>
        </div>
      </div>
      <div class="col-md-4 col-sm-6 col-xs-6 event-width">
        <div class="left common-res-bottom common-res-bottom-1">
          <ul class="content-ul no-padding no-margin">
            <li class="services-padding distab-cell-middle">
              <h3 class="left h3-bottom">Installation</h3>
              <p class="ls">We coordinate the delivery and installation of commercial architectural openings, whether partnering with your installers or providing a complete turnkey package.</p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Our Services end -->