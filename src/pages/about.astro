	<!--================================= ABOUT US START =============================================-->
    <section class="container-fluid section-space section-bg-1" id="about">
        <div class="container">
			<h2 class="center">Our Values</h2>
            <br />		
            <div class="row">
				<div class="col-md-6 col-sm-12">
					<div class="left res-image-bottom res-image-bottom-1">
						<img src="/images/750x500x1.jpg" alt="image" class="img-responsive" />
					</div>
				</div>
				<div class="col-md-6 col-sm-12">
					<div class="left care-top">
						<p class="p-bottom">Our mission is to identify customers that share our values and serve their every need throughout all project phases; design, budgeting, estimating, detailing, project delivery, and closeout. </p>
						<div class="left p-bottom">
							<ul class="content-ul no-padding no-margin about-icon1">
                                <li><p></p></li>
                                <li><h3>Our Core Values</h3></li>
								<li class="left-padding distab-cell-middle">
									<p class="ls"><b>Integrity:</b> We are always honest with our internal and external customers. <i>&quot;Let what you say be simply &#39;yes&#39; or &#39;no&#39;; anything else more than this comes from evil.&quot; Matthew 5:37</i></p>
								</li>
							</ul>
						</div>
						<div class="left p-bottom">
							<ul class="content-ul no-padding no-margin about-icon1">
								<li class="left-padding distab-cell-middle">
									<p class="ls"><b>Respect:</b> <i>&quot;Whatever you wish that others would do to you, do also to them.&quot; Matthew 7:12</i></p>
								</li>
							</ul>
						</div>
						<div class="left p-bottom">
							<ul class="content-ul no-padding no-margin about-icon1">
								<li class="left-padding distab-cell-middle">
									<p class="ls"><b>Responsibility:</b> Hold ourselves to the highest standards. <i>&quot;For each will have to bear his own load.&quot; Galatians 6:5</i></p>
								</li>
							</ul>
						</div>
                        <div class="left p-bottom">
							<ul class="content-ul no-padding no-margin about-icon1">
								<li class="left-padding distab-cell-middle">
									<p class="ls"><b>Partnership:</b> We value collaboration and teamwork both internally and externally.</i></p>
								</li>
							</ul>
						</div>
                            <div class="left p-bottom">
							<ul class="content-ul no-padding no-margin about-icon1">
                                <li><h3>Mission Statement</h3></li>
								<li class="left-padding distab-cell-middle">
									<p class="ls"> To identify customers that share our values and serve their every need throughout all project phases; design, budgeting, estimating, detailing, project delivery, and closeout.</i></p>
								</li>
							</ul>
						</div>
					</div>
				</div>
            </div>
        </div>
    </section>
    <!--================================= ABOUT US END =============================================-->