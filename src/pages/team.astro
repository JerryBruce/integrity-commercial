---
import Header from '../components/Header';
import Navbar from '../components/Navbar.jsx';
import PreHeader from '../components/PreHeader';

---

<link 
  href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" 
  rel="stylesheet"
/>
<script 
  src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js" 
  defer
></script>
<link rel="stylesheet" href="/css/style.css"/>
<PreHeader client:load/>
<Header client:load/>
<Navbar client:load/>

    <section class="container-fluid section-space section-bg-1">
        <div class="container">
			<h2 class="center">Our Team Members</h2>
            <div class="center no-fs underline-bottom">
            </div>
			
            <div class="row">
				<div class=" column-center no-padding member-width">
					<!--================= COLUMN-1 ========================-->
					<div class="col-md-3 col-sm-3 col-xs-6 four-column-res-bottom team-width">					
					</div>
					<div class="col-md-3 col-sm-3 col-xs-6 four-column-res-bottom team-width">
						<div class="team-width-inner">
							<div class="center team-inner-bg p-bottom">
								<img src="/images/Jake.png" data-src="/images/250x250x1-b.png" alt="jake" class="img-responsive price-image image-center icon-change" style="width: 250px; height: 250px; object-fit: cover; object-position: 50% 15%;" />
							</div>
							<h3 class="center client-name">Jake Hardin</h3>
							<div class="team-br"></div>
							<p class="center client-design">Husband and father of three boys, Jake is passionate about his faith, his church, and serving his community. He founded Integrity Commercial Openings in 2025 after recognizing a need in the market for better service and stronger partnerships built on trust and customer care.
						</div>
					</div>
					
					<!--================= COLUMN-2 ========================-->
					<div class="col-md-3 col-sm-3 col-xs-6 four-column-res-bottom team-width">
						<div class="team-width-inner">
							<div class="center team-inner-bg p-bottom">
								<img src="/images/Zach.png" data-src="/images/250x250x2-b.png" alt="image" class="img-responsive price-image image-center icon-change" />
							</div>
							<h3 class="center client-name">Zach Hazlewood</h3>
							<div class="team-br"></div>
							<p class="center client-design">With experience spanning counter sales, project management, and manufacturer representation, Zach brings a well-rounded perspective and a deep understanding of the industry. A husband and father of three, he is active in his church&#39;s children&#39;s ministry and worship team. Gig &#39;Em &#39;15!</p>
						</div>
					</div>
				</div>
				<div class="col-md-3 col-sm-3 col-xs-6 four-column-res-bottom team-width">					
				</div>
        </div>
    </section>
    <!--================================= OUR TEAM-1 END =============================================-->